  "alami": [
    {
      "penilai": "alami-p1",
      "paket": "tirt",
      "sumber": "agen-m2d5",
      "skor": 3,
      "alasan": "Pesan grupnya wajar, tetapi penjelasannya memakai istilah kaku seperti 'kartu penentu' dan 'cocok dengan catatan', dan pesan Nia ('ada di catatan resmi ya?') lebih mirip bahasa dokumen daripada obrolan."
    },
    {
      "penilai": "alami-p1",
      "paket": "tirt",
      "sumber": "agen-m2d4",
      "skor": 4,
      "alasan": "Pesan dan penjelasannya mengalir seperti teman menjelaskan ('kebablasan', 'mendinginkan harga'), hanya ada sedikit frasa janggal seperti 'tidak bisa dipindah ke hari ini'."
    },
    {
      "penilai": "alami-p1",
      "paket": "tirt",
      "sumber": "agen-m2d3",
      "skor": 4,
      "alasan": "Pesannya sangat hidup dan terasa obrolan sungguhan, tetapi beberapa kalimat penjelasan agak tersendat, misalnya 'Yang bikin orang salah kalau angka itu disangka...' dan 'yang awal tahun ragu soal kelanjutan usaha'."
    },
    {
      "penilai": "alami-p1",
      "paket": "ultj",
      "sumber": "manusia",
      "skor": 3,
      "alasan": "Rujukan berulang ke 'kartu pertama/kedua/ketiga', 'Jangan kegeeran dulu' yang maknanya kurang pas, dan kalimat salah-kaprah yang panjang terasa seperti terjemahan."
    },
    {
      "penilai": "alami-p1",
      "paket": "ultj",
      "sumber": "agen-m2d4",
      "skor": 3,
      "alasan": "Pesannya wajar ('ga pernah bolos'), tetapi penjelasannya mengulang pola kaku 'Kalau ... dibuka' dan 'Yang tidak terbaca di situ', ada frasa rancu seperti 'muncul 2 laporan', dan pilihan 'laporannya cuma dua laporan' berulang kata."
    },
    {
      "penilai": "alami-p2",
      "paket": "tirt",
      "sumber": "agen-m2d5",
      "skor": 3,
      "alasan": "Pesan grupnya wajar. Penjelasannya kaku karena istilah seperti \"kartu penentu\" dan \"kartu lain mencatat\", juga susunan janggal seperti \"21 Januari 2025 juga memuat penghentian perdagangan\" dan \"beralasan tidak sama\"."
    },
    {
      "penilai": "alami-p2",
      "paket": "tirt",
      "sumber": "agen-m2d4",
      "skor": 4,
      "alasan": "Pesan dan penjelasannya mengalir dan memakai ungkapan akrab seperti \"naik kebablasan\"; hanya frasa \"klaim teman soal hari ini cocok dengan dokumennya\" yang terasa sedikit formal dan berulang."
    },
    {
      "penilai": "alami-p2",
      "paket": "tirt",
      "sumber": "agen-m2d3",
      "skor": 4,
      "alasan": "Pesannya paling hidup, seperti obrolan grup sungguhan (\"Gila gue panik\", \"telat nyadar\"), dan penjelasannya bernada teman. Masih ada kalimat yang tersandung, misalnya \"Yang bikin orang salah kalau angka itu disangka...\" dan \"bursa menulis ragu soal kelanjutan usaha\"."
    },
    {
      "penilai": "alami-p2",
      "paket": "ultj",
      "sumber": "manusia",
      "skor": 3,
      "alasan": "Pesan seperti \"Jangan kegeeran dulu\" terdengar asli, tetapi penjelasannya terus merujuk ke \"kartu pertama/kedua/ketiga\" dan memakai frasa berbau terjemahan seperti \"menggerakkan porsi mereka\" dan \"dibaca sebagai satu blok besar\"."
    },
    {
      "penilai": "alami-p2",
      "paket": "ultj",
      "sumber": "agen-m2d4",
      "skor": 4,
      "alasan": "Pesan dan pilihannya santai dan wajar (\"ga pernah bolos. Aman lah\"). Penjelasannya jelas, tetapi polanya berulang (\"Kalau ... dibuka\", \"Yang tidak terbaca di situ\") dan ada frasa canggung seperti \"muncul 2 laporan\" dan \"laporannya cuma dua laporan\"."
    },
    {
      "penilai": "alami-p3",
      "paket": "tirt",
      "sumber": "agen-m2d5",
      "skor": 3,
      "alasan": "Pesan obrolannya wajar, tetapi penjelasannya memakai frasa kaku seperti \"kartu penentu menghitung selisih\", \"beralasan kenaikan harga kumulatif\", dan \"beralasan tidak sama\", yang tidak lazim diucapkan penutur asli."
    },
    {
      "penilai": "alami-p3",
      "paket": "tirt",
      "sumber": "agen-m2d4",
      "skor": 4,
      "alasan": "Pesan dan penjelasannya mengalir seperti teman yang menjelaskan (misalnya \"naik kebablasan\"), hanya sedikit terasa formal di bagian \"klaim teman soal hari ini cocok dengan dokumennya\"."
    },
    {
      "penilai": "alami-p3",
      "paket": "tirt",
      "sumber": "agen-m2d3",
      "skor": 4,
      "alasan": "Pesannya sangat hidup dan pilihannya selaras dengan ragam santai, tetapi ada kalimat yang strukturnya janggal, seperti \"Yang bikin orang salah kalau angka itu disangka...\" dan \"bursa menulis ragu soal kelanjutan usaha\"."
    },
    {
      "penilai": "alami-p3",
      "paket": "ultj",
      "sumber": "manusia",
      "skor": 3,
      "alasan": "Ada frasa alami (\"Setengah omongan Fajar cocok\"), tetapi rujukan meta seperti \"kartu kedua\" dan \"tidak dikatakan kartu mana pun\", nada menggurui \"Perhatikan...\", serta \"kegeeran\" yang maknanya kurang pas membuatnya kurang wajar."
    },
    {
      "penilai": "alami-p3",
      "paket": "ultj",
      "sumber": "agen-m2d4",
      "skor": 3,
      "alasan": "Pesannya wajar (\"ga pernah bolos\"), tetapi penjelasannya berpola templat berulang (\"Kalau daftar... dibuka\", \"Yang tidak terbaca di situ\") dan ada frasa janggal seperti \"muncul 2 laporan\" dan \"laporannya cuma dua laporan\"."
    }
  ],
