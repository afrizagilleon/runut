# Salin menjadi .env di akar repo, lalu isi nilainya sendiri (BYOK).
# .env tidak pernah di-commit; kunci hanya dibaca kode server, tidak pernah dikirim ke halaman.

# Kunci API Sectors (sectors.app) milikmu; hanya dipakai bila data emiten belum ada di cache.
SECTORS_API_KEY=
# Alamat API OpenRouter (https://openrouter.ai/api/v1).
LLM_BASE_URL=
# Kunci API OpenRouter milikmu.
LLM_API_KEY=
# Model bawaan (wajib diisi); agen memakai dua model tetap: deepseek/deepseek-v4.1-flash dan z-ai/glm-5.3.
LLM_MODEL=
# Pagu dolar kumulatif seluruh panggilan LLM dari mesin ini (ledger .cache/llm/ledger.jsonl).
LLM_PAGU_USD=
# Pagu kredit Sectors kumulatif (bawaan 613 bila kosong); panggilan yang melewatinya tidak dikirim.
SECTORS_KREDIT_PAGU=
