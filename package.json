{
  "name": "runut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "build:case": "node --experimental-strip-types factory/bangun-kasus.ts",
    "eval:pilih": "node --experimental-strip-types eval/pilih-kasus.ts",
    "eval:data": "node --experimental-strip-types eval/periksa-data.ts",
    "eval:jalan": "node --experimental-strip-types eval/jalan.ts",
    "eval:nilai": "node --experimental-strip-types eval/penilai.ts",
    "eval:bukti": "node --experimental-strip-types eval/bukti-penilai.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
